{
  "manifest_version": 3,
  "name": "NextDM Integration",
  "version": "0.1.0",
  "description": "Hand downloads from your browser to NextDM.",
  "browser_specific_settings": {
    "gecko": {
      "id": "nextdm@nextdm.app",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "downloads",
    "cookies",
    "nativeMessaging",
    "storage",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "NextDM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
