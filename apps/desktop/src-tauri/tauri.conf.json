{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NextDM",
  "version": "0.1.0",
  "identifier": "com.nextdm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NextDM",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Free download manager for Linux",
    "longDescription": "NextDM is a free and open source download manager for Linux with segmented downloads, resume, browser integration and media downloads.",
    "copyright": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "packaging/windows/installer_hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ],
        "files": {
          "/usr/bin/nextdm-host": "bin/nextdm-host",
          "/usr/share/nextdm/com.nextdm.host.chromium.json": "packaging/com.nextdm.host.chromium.json",
          "/usr/share/nextdm/com.nextdm.host.firefox.json": "packaging/com.nextdm.host.firefox.json",
          "/usr/share/nextdm/extensions/nextdm-chromium.zip": "extensions/nextdm-chromium.zip",
          "/usr/share/nextdm/extensions/nextdm-firefox.xpi": "extensions/nextdm-firefox.xpi"
        },
        "postInstallScript": "packaging/postinst",
        "postRemoveScript": "packaging/postrm"
      }
    }
  }
}
